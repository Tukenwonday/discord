{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cordis",
  "version": "1.0.0",
  "identifier": "com.cordis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cordis",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "_csp_ip_only_note": "IP-ONLY: TODO - CSP was nulled for bare-IP deployment. A null CSP disables Content-Security-Policy entirely, so any XSS in the webview gains unrestricted network access. To restore protection, either pin the host (connect-src must include http://34.165.143.31:8080, ws://34.165.143.31:8080 and ws://34.165.143.31:7880) or go back to the previous value listed in README section 6.",
      "csp": null,
      "capabilities": []
    },
    "trayIcon": {
      "id": "cordis-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Cordis",
      "menuOnLeftClick": false
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY_FROM_TAURI_SIGNER",
      "endpoints": [
        "https://releases.cordis.dev/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 Cordis Team",
    "category": "SocialNetworking",
    "shortDescription": "Cordis desktop client",
    "longDescription": "Cordis is a real-time chat client for servers, channels and direct messages with built-in voice and video.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "webviewInstallMode": {
      "type": "downloadBootstrapper",
      "silent": true
    }
  }
}