# ---------------------------------------------------------------------------
# Cordis - copy to .env and adjust before running `docker compose up -d`
# Every variable below is read by the backend (see backend/internal/config).
# ---------------------------------------------------------------------------

# --- Core application -------------------------------------------------------
APP_ENV=development
PORT=8080
GIN_MODE=debug
TZ=UTC
# IP-ONLY: TODO - bare IP deployment, no domain and no TLS. Switch to
# https://<domain> once a certificate is in front of the reverse proxy.
PUBLIC_URL=http://34.165.143.31:8080

# --- Database (PostgreSQL 16) ----------------------------------------------
POSTGRES_USER=cordis
POSTGRES_PASSWORD=cordis
POSTGRES_DB=cordis
# Inside Docker Compose use the service hostname (postgres), not localhost.
DATABASE_URL=postgres://cordis:cordis@postgres:5432/cordis?sslmode=disable
# Running the backend natively on Windows? Use this instead:
# DATABASE_URL=postgres://cordis:cordis@localhost:5432/cordis?sslmode=disable

# --- Redis 7 ----------------------------------------------------------------
# Inside Docker Compose use redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# Running the backend natively on Windows? Use redis://localhost:6379/0
REDIS_CHANNEL=cordis:events

# --- Auth -------------------------------------------------------------------
# MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- CORS / reverse proxy ---------------------------------------------------
# Comma separated list of allowed origins (Tauri dev server + Vite dev server).
# IP-ONLY: TODO - wildcard origin so the Tauri client and any http:// origin on
# this IP can call the API. The middleware already treats "*" as "allow all".
# Replace with explicit origins (http://34.165.143.31:8080) when a domain exists.
CORS_ORIGINS=*
# Comma separated CIDRs of proxies you trust for client IPs, e.g. 172.16.0.0/12
TRUSTED_PROXIES=

# --- Messaging limits -------------------------------------------------------
MAX_MESSAGE_LEN=4000

# --- LiveKit (self-hosted voice/video) --------------------------------------
# IP-ONLY: TODO - advertised to desktop clients, so it must be the public IP.
# Use wss:// once TLS terminates in front of LiveKit.
LIVEKIT_URL=ws://34.165.143.31:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# The URL the LiveKit server advertises to clients. Must be reachable from the
# desktop client machine, not from inside the Docker network.
# IP-ONLY: TODO - must be the public IP so ICE can resolve the host.
SELF_HOSTED_DOMAIN=http://34.165.143.31:8080

# --- File uploads -----------------------------------------------------------
# local = filesystem under UPLOAD_DIR, s3 = any S3 compatible provider
UPLOAD_DRIVER=local
UPLOAD_DIR=./data/uploads
# IP-ONLY: TODO - attachment URLs are handed to clients as absolute URLs.
UPLOAD_PUBLIC_BASE=http://34.165.143.31:8080/uploads
MAX_UPLOAD_MB=25

# --- S3 compatible storage (only used when UPLOAD_DRIVER=s3) ----------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cordis
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Desktop app build-time variables live in desktop/.env.example instead,
# because Vite inlines import.meta.env.* at build time.
# ---------------------------------------------------------------------------
